  "configuration": {
    "title": "PDF Workshop",
    "properties": {
      "pdfWorkshop.outline.followCursor": {
        "type": "boolean",
        "default": false,
        "description": "Reveal and select the bookmark containing the current PDF page and reading position in PDF Outline, without moving focus. Toggle Follow Cursor in the outline's More Actions menu."
      },
      "pdfWorkshop.copyLinkForAgent.target": {
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "cursor",
          "chat",
          "claudeCode",
          "codex",
          "clipboard"
        ],
        "enumDescriptions": [
          "The editor's own chat (Cursor, or VS Code with a chat extension such as Copilot Chat) when it is the only agent installed; with Claude Code or Codex installed too, only copy, to paste into the agent you use.",
          "Cursor's chat.",
          "VS Code's chat.",
          "Claude Code: a new conversation with the selection typed in.",
          "Codex: the selection (and a region's snapshot) attached to the thread.",
          "Only copy the selection."
        ],
        "markdownDescription": "Which agent chat, if any, **Copy Link for Agent** opens with a PDF selection. The link and selection are always copied. Extensions cannot see which agent you are working in, so `auto` only opens a chat when there is a single agent; pick one here to send the selection to it."
      },
      "pdfWorkshop.regionImageCache.maxSizeMB": {
        "type": "number",
        "default": 100,
        "minimum": 1,
        "markdownDescription": "The most disk space, in megabytes, that PNG snapshots of selected regions may use in the extension's storage. This is a hard limit: when a new snapshot takes them past it, the least recently used ones are deleted, and a single snapshot larger than the limit is not saved (Copy Link for Agent then copies the link without the image). Values below 1 count as 1."
      },
      "pdfWorkshop.toolbar.mode": {
        "type": "string",
        "default": "chrome",
        "enum": [
          "chrome",
          "slim",
          "floating",
          "none"
        ],
        "enumDescriptions": [
          "VS Code title actions and status bar entries for page, zoom and View (layout and scrolling).",
          "A slim bar along the top of the viewer.",
          "A bar floating over the pages, docked to an edge of the viewer; drag it by its grip to another edge.",
          "No controls: keyboard shortcuts, the right-click menu and the command palette only."
        ],
        "markdownDescription": "Where the page, zoom, find and tool controls of the PDF viewer appear. Every control also has a command and a keyboard shortcut."
      },
      "pdfWorkshop.toolbar.statusBarButtons": {
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "always",
          "never"
        ],
        "enumDescriptions": [
          "In Cursor, which keeps extension buttons in the editor title bar's \"…\" menu: yes. In VS Code: no.",
          "Always show the buttons.",
          "Only the page, zoom and View."
        ],
        "markdownDescription": "With `#pdfWorkshop.toolbar.mode#` set to `chrome`, whether the status bar also shows previous and next page, zoom out and in, and find buttons around the page and zoom."
      },
      "pdfWorkshop.agentBridge.enabled": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "**Experimental, off by default.** Serve the current PDF selection to coding agents (VS Code chat, Cursor, Claude Code, Codex) over a local MCP server: 127.0.0.1 only, a random port, a bearer token, no browser origins. It starts and stops when this changes. **PDF: Copy MCP Setup for Claude Code / Codex…** gives the command that connects those agents."
      },
      "pdfWorkshop.view.defaultZoom": {
        "type": [
          "string",
          "number"
        ],
        "default": "fitWidth",
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "fitWidth",
              "fitPage",
              "actual"
            ]
          },
          {
            "type": "number",
            "minimum": 25,
            "maximum": 400
          }
        ],
        "markdownDescription": "Zoom for PDFs without a saved view: fit width, fit page, actual size (100%), or a numeric percentage (25–400)."
      },
      "pdfWorkshop.view.pageLayout": {
        "type": "string",
        "default": "single",
        "enum": [
          "single",
          "spread",
          "spreadCover"
        ],
        "enumDescriptions": [
          "One page per row.",
          "Pair pages 1–2, 3–4, and so on.",
          "Cover page alone, then pair pages 2–3, 4–5, and so on."
        ],
        "markdownDescription": "Page layout for PDFs without a saved view."
      },
      "pdfWorkshop.view.scrollMode": {
        "type": "string",
        "default": "continuous",
        "enum": [
          "continuous",
          "paged"
        ],
        "enumDescriptions": [
          "Scroll through the document.",
          "Show one page or spread at a time; use next/previous to change it."
        ],
        "markdownDescription": "Scrolling mode for PDFs without a saved view."
      },
      "pdfWorkshop.view.scrollDirection": {
        "type": "string",
        "default": "vertical",
        "enum": [
          "vertical",
          "horizontal"
        ],
        "markdownDescription": "Reading direction for PDFs without a saved view."
      },
      "pdfWorkshop.lookUp.enabled": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "macOS only: look up the word under the pointer in the Dictionary app with a force click (hard press on the trackpad), or with **Look Up** in the right-click menu of a PDF. Has no effect on other systems."
      },
      "pdfWorkshop.keyboardShortcuts": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "Default keyboard shortcuts of the PDF viewer, active only while a PDF is the active editor and focus is not in an input, the side bar, the panel or the auxiliary bar. They take Ctrl/⌘+G (Go to Line elsewhere), Ctrl/⌘+0 (focus the side bar), Ctrl/⌘+= and Ctrl/⌘+- (zoom the window) and Ctrl/⌘+F in that situation. Turn off to leave every key to VS Code; each **PDF:** command can still be bound in Keyboard Shortcuts."
      },
      "pdfWorkshop.view.restoreOnReopen": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "Reopen each PDF at its last page, scroll position, zoom and view choices (layout, scrolling, direction). When off, every PDF opens with the defaults above."
      },
      "pdfWorkshop.view.smoothScrolling": {
        "type": [
          "boolean",
          "null"
        ],
        "default": null,
        "markdownDescription": "Animate discrete mouse-wheel scrolling, page jumps and displayed zoom changes. `null` follows `#editor.smoothScrolling#`; `false` disables motion. Always disabled when the system prefers reduced motion."
      }
    }
  },
  "keybindings": [
    {
      "command": "pdfWorkshop.previousPageKeepingPlace",
      "key": "ctrl+alt+left",
      "mac": "alt+left",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.previousPageKeepingPlace",
      "key": "ctrl+alt+up",
      "mac": "alt+up",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.nextPageKeepingPlace",
      "key": "ctrl+alt+right",
      "mac": "alt+right",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.nextPageKeepingPlace",
      "key": "ctrl+alt+down",
      "mac": "alt+down",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.enterZen",
      "key": "ctrl+alt+z",
      "mac": "ctrl+cmd+z",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts && !inZenMode"
    },
    {
      "command": "pdfWorkshop.exitZen",
      "key": "ctrl+alt+z",
      "mac": "ctrl+cmd+z",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts && inZenMode"
    },
    {
      "command": "pdfWorkshop.exitZen",
      "key": "escape escape",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts && inZenMode"
    },
    {
      "command": "pdfWorkshop.previousPage",
      "key": "alt+pageup",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.nextPage",
      "key": "alt+pagedown",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.goToPage",
      "key": "ctrl+g",
      "mac": "ctrl+g",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.zoomIn",
      "key": "ctrl+=",
      "mac": "cmd+=",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.zoomIn",
      "key": "ctrl+numpad_add",
      "mac": "cmd+numpad_add",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.zoomOut",
      "key": "ctrl+-",
      "mac": "cmd+-",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.zoomOut",
      "key": "ctrl+numpad_subtract",
      "mac": "cmd+numpad_subtract",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.fitWidth",
      "key": "ctrl+0",
      "mac": "cmd+0",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.fitPage",
      "key": "ctrl+alt+0",
      "mac": "cmd+alt+0",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.find",
      "key": "ctrl+f",
      "mac": "cmd+f",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.outline.focus",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && focusedView != 'pdfWorkshop.outline' && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "workbench.action.closeSidebar",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "focusedView == 'pdfWorkshop.outline' && sideBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "workbench.action.closeAuxiliaryBar",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "focusedView == 'pdfWorkshop.outline' && auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "workbench.action.closePanel",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "focusedView == 'pdfWorkshop.outline' && panelFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.selectTextTool",
      "key": "ctrl+alt+t",
      "mac": "ctrl+cmd+t",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    },
    {
      "command": "pdfWorkshop.selectRegionTool",
      "key": "ctrl+alt+r",
      "mac": "ctrl+cmd+r",
      "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.pdfWorkshop.keyboardShortcuts"
    }
  ],
  "mcpServerDefinitionProviders": [
    {
      "id": "pdfWorkshop.agentBridge",
      "label": "PDF Workshop"
    }
  ]
}
