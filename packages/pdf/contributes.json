{
  "customEditors": [
    {
      "viewType": "pdfWorkshop.viewer",
      "displayName": "PDF Workshop",
      "selector": [
        {
          "filenamePattern": "*.pdf"
        }
      ],
      "priority": "default"
    }
  ],
  "views": {
    "explorer": [
      {
        "id": "pdfWorkshop.outline",
        "name": "PDF Outline",
        "when": "pdfWorkshop.pdfActive"
      }
    ]
  },
  "viewsWelcome": [
    {
      "view": "pdfWorkshop.outline",
      "contents": "Reading the outline…",
      "when": "pdfWorkshop.outlineLoading"
    },
    {
      "view": "pdfWorkshop.outline",
      "contents": "This PDF has no outline.",
      "when": "!pdfWorkshop.outlineLoading"
    }
  ],
  "commands": [
    {
      "command": "pdfWorkshop.lookUp",
      "title": "Look Up",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.openSettings",
      "title": "Open Settings",
      "category": "PDF",
      "icon": "$(settings-gear)"
    },
    {
      "command": "pdfWorkshop.changeSetting",
      "title": "Change Setting…",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.toggleSmoothScrolling",
      "title": "Toggle Smooth Scrolling",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.toggleKeyboardShortcuts",
      "title": "Toggle Keyboard Shortcuts",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.setDefaultZoom",
      "title": "Set Default Zoom…",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.setDefaultPageLayout",
      "title": "Set Default Page Layout…",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.setDefaultScrollMode",
      "title": "Set Default Scrolling…",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.enterZen",
      "title": "Enter Zen Mode",
      "category": "PDF",
      "icon": "$(screen-full)"
    },
    {
      "command": "pdfWorkshop.exitZen",
      "title": "Exit Zen Mode",
      "category": "PDF",
      "icon": "$(screen-normal)"
    },
    {
      "command": "pdfWorkshop.previousPageKeepingPlace",
      "title": "Previous Page, Keeping Place",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.nextPageKeepingPlace",
      "title": "Next Page, Keeping Place",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.copyLinkForAgent",
      "title": "Copy Link for Agent",
      "category": "PDF",
      "icon": "$(comment-discussion)",
      "enablement": "pdfWorkshop.hasSelection"
    },
    {
      "command": "vscodeEmbedPdf.bridge.envelope",
      "title": "Selection Envelope",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.openLocation",
      "title": "Open Location…",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.openNativeLink",
      "title": "Open PDF Link",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.goToOutlineItem",
      "title": "Go to Outline Item",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.expandOutline",
      "title": "Expand All",
      "category": "PDF",
      "icon": "$(expand-all)"
    },
    {
      "command": "pdfWorkshop.enableOutlineFollowCursor",
      "title": "Follow Cursor",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.disableOutlineFollowCursor",
      "title": "Follow Cursor",
      "category": "PDF",
      "icon": "$(check)"
    },
    {
      "command": "pdfWorkshop.copyMcpSetup",
      "title": "Copy MCP Setup for Claude Code / Codex…",
      "category": "PDF"
    },
    {
      "command": "pdfWorkshop.previousPage",
      "title": "Previous Page",
      "category": "PDF",
      "icon": "$(chevron-up)",
      "enablement": "pdfWorkshop.pdfActive && pdfWorkshop.canGoBack"
    },
    {
      "command": "pdfWorkshop.nextPage",
      "title": "Next Page",
      "category": "PDF",
      "icon": "$(chevron-down)",
      "enablement": "pdfWorkshop.pdfActive && pdfWorkshop.canGoForward"
    },
    {
      "command": "pdfWorkshop.goToPage",
      "title": "Go to Page…",
      "category": "PDF",
      "icon": "$(list-ordered)"
    },
    {
      "command": "pdfWorkshop.zoomOut",
      "title": "Zoom Out",
      "category": "PDF",
      "icon": "$(zoom-out)"
    },
    {
      "command": "pdfWorkshop.zoomIn",
      "title": "Zoom In",
      "category": "PDF",
      "icon": "$(zoom-in)"
    },
    {
      "command": "pdfWorkshop.selectZoom",
      "title": "Zoom…",
      "category": "PDF",
      "icon": "$(search-fuzzy)"
    },
    {
      "command": "pdfWorkshop.fitWidth",
      "title": "Fit Width",
      "category": "PDF",
      "icon": "$(arrow-both)"
    },
    {
      "command": "pdfWorkshop.fitPage",
      "title": "Fit Page",
      "category": "PDF",
      "icon": "$(screen-full)"
    },
    {
      "command": "pdfWorkshop.find",
      "title": "Find in PDF",
      "category": "PDF",
      "icon": "$(search)"
    },
    {
      "command": "pdfWorkshop.toggleOutline",
      "title": "Toggle Outline",
      "category": "PDF",
      "icon": "$(list-tree)"
    },
    {
      "command": "pdfWorkshop.selectTextTool",
      "title": "Select Text Tool",
      "category": "PDF",
      "icon": "$(whole-word)"
    },
    {
      "command": "pdfWorkshop.selectRegionTool",
      "title": "Select Region Tool",
      "category": "PDF",
      "icon": "$(inspect)"
    },
    {
      "command": "pdfWorkshop.selectToolbarMode",
      "title": "Choose Toolbar Location…",
      "category": "PDF",
      "icon": "$(layout)"
    },
    {
      "command": "pdfWorkshop.actualSize",
      "title": "Actual Size (100%)",
      "category": "PDF",
      "icon": "$(symbol-numeric)",
      "enablement": "pdfWorkshop.pdfActive"
    },
    {
      "command": "pdfWorkshop.selectView",
      "title": "View…",
      "category": "PDF",
      "icon": "$(layout)",
      "enablement": "pdfWorkshop.pdfActive"
    },
    {
      "command": "pdfWorkshop.singlePage",
      "title": "Single Page",
      "category": "PDF",
      "icon": "$(file)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.pageLayout == 'single'"
    },
    {
      "command": "pdfWorkshop.twoPageSpread",
      "title": "Two Pages (1–2, 3–4)",
      "category": "PDF",
      "icon": "$(book)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.pageLayout == 'spread'"
    },
    {
      "command": "pdfWorkshop.twoPageCover",
      "title": "Two Pages with Cover (1, 2–3)",
      "category": "PDF",
      "icon": "$(book)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.pageLayout == 'spreadCover'"
    },
    {
      "command": "pdfWorkshop.continuousScroll",
      "title": "Continuous Scrolling",
      "category": "PDF",
      "icon": "$(list-ordered)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.scrollMode == 'continuous'"
    },
    {
      "command": "pdfWorkshop.pageByPage",
      "title": "Page-by-page Scrolling",
      "category": "PDF",
      "icon": "$(file)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.scrollMode == 'paged'"
    },
    {
      "command": "pdfWorkshop.verticalScroll",
      "title": "Vertical Scrolling",
      "category": "PDF",
      "icon": "$(arrow-down)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.scrollDirection == 'vertical'"
    },
    {
      "command": "pdfWorkshop.horizontalScroll",
      "title": "Horizontal Scrolling",
      "category": "PDF",
      "icon": "$(arrow-right)",
      "enablement": "pdfWorkshop.pdfActive",
      "toggled": "pdfWorkshop.scrollDirection == 'horizontal'"
    },
    {
      "command": "pdfWorkshop.historyBack",
      "title": "Back to Previous Location",
      "category": "PDF",
      "icon": "$(arrow-left)",
      "enablement": "pdfWorkshop.historyBack"
    },
    {
      "command": "pdfWorkshop.historyForward",
      "title": "Forward to Next Location",
      "category": "PDF",
      "icon": "$(arrow-right)",
      "enablement": "pdfWorkshop.historyForward"
    },
    {
      "command": "pdfWorkshop.ideContext.copy",
      "title": "Copy IDE Context",
      "category": "PDF Workshop"
    },
    {
      "command": "pdfWorkshop.ideContext.send",
      "title": "Send IDE Context to Agent…",
      "category": "PDF Workshop"
    }
  ],
  "menus": {
    "view/title": [
      {
        "command": "pdfWorkshop.expandOutline",
        "when": "view == pdfWorkshop.outline",
        "group": "navigation@1"
      },
      {
        "command": "pdfWorkshop.enableOutlineFollowCursor",
        "when": "view == pdfWorkshop.outline && !pdfWorkshop.outlineFollowCursor",
        "group": "1_outline@1"
      },
      {
        "command": "pdfWorkshop.disableOutlineFollowCursor",
        "when": "view == pdfWorkshop.outline && pdfWorkshop.outlineFollowCursor",
        "group": "1_outline@1"
      }
    ],
    "editor/title": [
      {
        "command": "pdfWorkshop.historyBack",
        "when": "activeCustomEditorId == 'pdfWorkshop.viewer' && config.pdfWorkshop.toolbar.mode == 'chrome'",
        "group": "navigation@8"
      },
      {
        "command": "pdfWorkshop.historyForward",
