        "group": "2_pdfTool@1"
      },
      {
        "command": "lumiere.pdf.selectTextTool",
        "when": "webviewId == 'lumiere.pdf.viewer' && lumiere.pdf.tool == 'region'",
        "group": "2_pdfTool@1"
      },
      {
        "command": "lumiere.pdf.enterZen",
        "when": "webviewId == 'lumiere.pdf.viewer' && !inZenMode",
        "group": "4_pdfZen@1"
      },
      {
        "command": "lumiere.pdf.openSettings",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "5_pdfSettings@1"
      },
      {
        "command": "lumiere.pdf.exitZen",
        "when": "webviewId == 'lumiere.pdf.viewer' && inZenMode",
        "group": "4_pdfZen@1"
      },
      {
        "command": "lumiere.pdf.actualSize",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@1"
      },
      {
        "command": "lumiere.pdf.selectView",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@2"
      },
      {
        "command": "lumiere.pdf.singlePage",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@3"
      },
      {
        "command": "lumiere.pdf.twoPageSpread",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@4"
      },
      {
        "command": "lumiere.pdf.twoPageCover",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@5"
      },
      {
        "command": "lumiere.pdf.continuousScroll",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@6"
      },
      {
        "command": "lumiere.pdf.pageByPage",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@7"
      },
      {
        "command": "lumiere.pdf.verticalScroll",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@8"
      },
      {
        "command": "lumiere.pdf.horizontalScroll",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "3_pdfView@9"
      }
    ]
  },
  "configuration": {
    "title": "Lumi\u00e8re PDF",
    "properties": {
      "lumiere.pdf.outline.followCursor": {
        "type": "boolean",
        "default": false,
        "description": "Reveal and select the bookmark containing the current PDF page and reading position in PDF Outline, without moving focus. Toggle Follow Cursor in the outline's More Actions menu."
      },
      "lumiere.pdf.copyLinkForAgent.target": {
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "cursor",
          "chat",
          "claudeCode",
          "codex",
          "clipboard"
        ],
        "enumDescriptions": [
          "The editor's own chat (Cursor, or VS Code with a chat extension such as Copilot Chat) when it is the only agent installed; with Claude Code or Codex installed too, only copy, to paste into the agent you use.",
          "Cursor's chat.",
          "VS Code's chat.",
          "Claude Code: a new conversation with the selection typed in.",
          "Codex: the selection (and a region's snapshot) attached to the thread.",
          "Only copy the selection."
        ],
        "markdownDescription": "Which agent chat, if any, **Copy Link for Agent** opens with a PDF selection. The link and selection are always copied. Extensions cannot see which agent you are working in, so `auto` only opens a chat when there is a single agent; pick one here to send the selection to it."
      },
      "lumiere.pdf.regionImageCache.maxSizeMB": {
        "type": "number",
        "default": 100,
        "minimum": 1,
        "markdownDescription": "The most disk space, in megabytes, that PNG snapshots of selected regions may use in the extension's storage. This is a hard limit: when a new snapshot takes them past it, the least recently used ones are deleted, and a single snapshot larger than the limit is not saved (Copy Link for Agent then copies the link without the image). Values below 1 count as 1."
      },
      "lumiere.pdf.toolbar.mode": {
        "type": "string",
        "default": "chrome",
        "enum": [
          "chrome",
          "none"
        ],
        "enumDescriptions": [
          "VS Code status bar entries for page, zoom, View, page colors and navigation.",
          "No status-bar PDF entries: keyboard shortcuts, menus and the command palette only."
        ],
        "markdownDescription": "Where the page, zoom, find and page-colors controls of the PDF viewer appear. Slim and floating viewer bars were removed. Every control also has a command and a keyboard shortcut."
      },
      "lumiere.pdf.toolbar.statusBarButtons": {
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "always",
          "never"
        ],
        "enumDescriptions": [
          "In Cursor, which keeps extension buttons in the editor title bar's \"\u2026\" menu: yes. In VS Code: no.",
          "Always show the buttons.",
          "Only the page, zoom and View."
        ],
        "markdownDescription": "With `#lumiere.pdf.toolbar.mode#` set to `chrome`, whether the status bar also shows history, previous and next page, zoom out and in, and find buttons around the page and zoom."
      },
      "lumiere.pdf.agentBridge.enabled": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "**Experimental, off by default.** Serve the current PDF selection to coding agents (VS Code chat, Cursor, Claude Code, Codex) over a local MCP server: 127.0.0.1 only, a random port, a bearer token, no browser origins. It starts and stops when this changes. **PDF: Copy MCP Setup for Claude Code / Codex\u2026** gives the command that connects those agents."
      },
      "lumiere.pdf.view.defaultZoom": {
        "type": [
          "string",
          "number"
        ],
        "default": "fitWidth",
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "fitWidth",
              "fitPage",
              "actual"
            ]
          },
          {
            "type": "number",
            "minimum": 25,
            "maximum": 400
          }
        ],
        "markdownDescription": "Zoom for PDFs without a saved view: fit width, fit page, actual size (100%), or a numeric percentage (25\u2013400)."
      },
      "lumiere.pdf.view.pageLayout": {
        "type": "string",
        "default": "single",
        "enum": [
          "single",
          "spread",
          "spreadCover"
        ],
        "enumDescriptions": [
          "One page per row.",
          "Pair pages 1\u20132, 3\u20134, and so on.",
          "Cover page alone, then pair pages 2\u20133, 4\u20135, and so on."
        ],
        "markdownDescription": "Page layout for PDFs without a saved view."
      },
      "lumiere.pdf.view.scrollMode": {
        "type": "string",
        "default": "continuous",
        "enum": [
          "continuous",
          "paged"
        ],
        "enumDescriptions": [
          "Scroll through the document.",
          "Show one page or spread at a time; use next/previous to change it."
        ],
        "markdownDescription": "Scrolling mode for PDFs without a saved view."
      },
      "lumiere.pdf.view.scrollDirection": {
        "type": "string",
        "default": "vertical",
        "enum": [
          "vertical",
          "horizontal"
        ],
        "markdownDescription": "Reading direction for PDFs without a saved view."
      },
      "lumiere.pdf.lookUp.enabled": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "macOS only: look up the word under the pointer in the Dictionary app with a force click (hard press on the trackpad), or with **Look Up** in the right-click menu of a PDF. Has no effect on other systems."
      },
      "lumiere.pdf.keyboardShortcuts": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "Default keyboard shortcuts of the PDF viewer, active only while a PDF is the active editor and focus is not in an input, the side bar, the panel or the auxiliary bar. They take Ctrl/\u2318+G (Go to Line elsewhere), Ctrl/\u2318+0 (focus the side bar), Ctrl/\u2318+= and Ctrl/\u2318+- (zoom the window) and Ctrl/\u2318+F in that situation. Turn off to leave every key to VS Code; each **PDF:** command can still be bound in Keyboard Shortcuts."
      },
      "lumiere.pdf.view.restoreOnReopen": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "Reopen each PDF at its last page, scroll position, zoom and view choices (layout, scrolling, direction). When off, every PDF opens with the defaults above."
      },
      "lumiere.pdf.view.smoothScrolling": {
        "type": [
          "boolean",
          "null"
        ],
        "default": null,
        "markdownDescription": "Animate discrete mouse-wheel scrolling, page jumps and displayed zoom changes. `null` follows `#editor.smoothScrolling#`; `false` disables motion. Always disabled when the system prefers reduced motion."
      },
      "lumiere.pdf.pageColors": {
        "type": "string",
        "default": "follow",
        "enum": [
          "follow",
          "normal",
          "dark"
        ],
        "enumDescriptions": [
          "Match the editor color theme kind: dark themes get dark paper; light themes stay normal.",
          "White paper (classic PDF rendering).",
          "Dark paper with recolored text and vectors; embedded images stay as-is. Scanned pages stay largely bright."
        ],
        "markdownDescription": "PDF page surface colors. **Follow** tracks `#window.activeColorTheme#` kind. Dark paper uses a patched EmbedPDF engines path (`FPDF_RenderPageBitmapWithColorScheme_Start`; see embedpdf#679). Scanned and image-only pages stay largely bright. No CSS invert."
      }
    }
  },
  "keybindings": [
    {
      "command": "lumiere.pdf.previousPageKeepingPlace",
      "key": "ctrl+alt+left",
      "mac": "alt+left",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.previousPageKeepingPlace",
      "key": "ctrl+alt+up",
      "mac": "alt+up",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.nextPageKeepingPlace",
      "key": "ctrl+alt+right",
      "mac": "alt+right",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.nextPageKeepingPlace",
      "key": "ctrl+alt+down",
      "mac": "alt+down",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.enterZen",
      "key": "ctrl+alt+z",
      "mac": "ctrl+cmd+z",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts && !inZenMode"
    },
    {
      "command": "lumiere.pdf.exitZen",
      "key": "ctrl+alt+z",
      "mac": "ctrl+cmd+z",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts && inZenMode"
    },
    {
      "command": "lumiere.pdf.exitZen",
      "key": "escape escape",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts && inZenMode"
    },
    {
      "command": "lumiere.pdf.previousPage",
      "key": "alt+pageup",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.nextPage",
      "key": "alt+pagedown",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.goToPage",
      "key": "ctrl+g",
      "mac": "ctrl+g",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.goToOutlineItem",
      "key": "ctrl+shift+o",
      "mac": "cmd+shift+o",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.zoomIn",
      "key": "ctrl+=",
      "mac": "cmd+=",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.zoomIn",
      "key": "ctrl+numpad_add",
      "mac": "cmd+numpad_add",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.zoomOut",
      "key": "ctrl+-",
      "mac": "cmd+-",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.zoomOut",
      "key": "ctrl+numpad_subtract",
      "mac": "cmd+numpad_subtract",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.fitWidth",
      "key": "ctrl+0",
      "mac": "cmd+0",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.fitPage",
      "key": "ctrl+alt+0",
      "mac": "cmd+alt+0",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.find",
      "key": "ctrl+f",
      "mac": "cmd+f",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.outline.focus",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && focusedView != 'lumiere.pdf.outline' && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "workbench.action.closeSidebar",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "focusedView == 'lumiere.pdf.outline' && sideBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "workbench.action.closeAuxiliaryBar",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "focusedView == 'lumiere.pdf.outline' && auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "workbench.action.closePanel",
      "key": "ctrl+alt+o",
      "mac": "ctrl+cmd+o",
      "when": "focusedView == 'lumiere.pdf.outline' && panelFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.selectTextTool",
      "key": "ctrl+alt+t",
      "mac": "ctrl+cmd+t",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.selectRegionTool",
      "key": "ctrl+alt+r",
      "mac": "ctrl+cmd+r",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    },
    {
      "command": "lumiere.pdf.toggleAnnotateTool",
      "key": "ctrl+alt+a",
      "mac": "ctrl+cmd+a",
      "when": "activeCustomEditorId == 'lumiere.pdf.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && config.lumiere.pdf.keyboardShortcuts"
    }
  ],
  "mcpServerDefinitionProviders": [
    {
      "id": "lumiere.pdf.agentBridge",
      "label": "Lumi\u00e8re PDF"
    }
  ]
}
