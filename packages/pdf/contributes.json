{
  "customEditors": [
    {
      "viewType": "lumiere.pdf.viewer",
      "displayName": "Lumi\u00e8re PDF",
      "selector": [
        {
          "filenamePattern": "*.pdf"
        }
      ],
      "priority": "default"
    }
  ],
  "views": {
    "explorer": [
      {
        "id": "lumiere.pdf.outline",
        "name": "PDF Outline",
        "when": "lumiere.pdf.pdfActive",
        "visibility": "visible"
      }
    ]
  },
  "viewsWelcome": [
    {
      "view": "lumiere.pdf.outline",
      "contents": "Reading the outline\u2026",
      "when": "lumiere.pdf.outlineLoading"
    },
    {
      "view": "lumiere.pdf.outline",
      "contents": "This PDF has no outline.",
      "when": "!lumiere.pdf.outlineLoading"
    }
  ],
  "commands": [
    {
      "command": "lumiere.pdf.lookUp",
      "title": "Look Up",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.openSettings",
      "title": "Open Settings",
      "category": "PDF",
      "icon": "$(settings-gear)"
    },
    {
      "command": "lumiere.pdf.changeSetting",
      "title": "Change Setting\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.toggleSmoothScrolling",
      "title": "Toggle Smooth Scrolling",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.toggleKeyboardShortcuts",
      "title": "Toggle Keyboard Shortcuts",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.setDefaultZoom",
      "title": "Set Default Zoom\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.setDefaultPageLayout",
      "title": "Set Default Page Layout\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.setDefaultScrollMode",
      "title": "Set Default Scrolling\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.enterZen",
      "title": "Enter Zen Mode",
      "category": "PDF",
      "icon": "$(screen-full)"
    },
    {
      "command": "lumiere.pdf.exitZen",
      "title": "Exit Zen Mode",
      "category": "PDF",
      "icon": "$(screen-normal)"
    },
    {
      "command": "lumiere.pdf.previousPageKeepingPlace",
      "title": "Previous Page, Keeping Place",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.nextPageKeepingPlace",
      "title": "Next Page, Keeping Place",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.copyLinkForAgent",
      "title": "Copy Link for Agent",
      "category": "PDF",
      "icon": "$(comment-discussion)",
      "enablement": "lumiere.pdf.hasSelection"
    },
    {
      "command": "vscodeEmbedPdf.bridge.envelope",
      "title": "Selection Envelope",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.openLocation",
      "title": "Open Location\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.openNativeLink",
      "title": "Open PDF Link",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.goToOutlineItem",
      "title": "Go to Outline Item\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.expandOutline",
      "title": "Expand All",
      "category": "PDF",
      "icon": "$(expand-all)"
    },
    {
      "command": "lumiere.pdf.enableOutlineFollowCursor",
      "title": "Follow Cursor",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.disableOutlineFollowCursor",
      "title": "Follow Cursor",
      "category": "PDF",
      "icon": "$(check)"
    },
    {
      "command": "lumiere.pdf.copyMcpSetup",
      "title": "Copy MCP Setup for Claude Code / Codex\u2026",
      "category": "PDF"
    },
    {
      "command": "lumiere.pdf.previousPage",
      "title": "Previous Page",
      "category": "PDF",
      "icon": "$(chevron-up)",
      "enablement": "lumiere.pdf.pdfActive && lumiere.pdf.canGoBack"
    },
    {
      "command": "lumiere.pdf.nextPage",
      "title": "Next Page",
      "category": "PDF",
      "icon": "$(chevron-down)",
      "enablement": "lumiere.pdf.pdfActive && lumiere.pdf.canGoForward"
    },
    {
      "command": "lumiere.pdf.goToPage",
      "title": "Go to Page\u2026",
      "category": "PDF",
      "icon": "$(list-ordered)"
    },
    {
      "command": "lumiere.pdf.zoomOut",
      "title": "Zoom Out",
      "category": "PDF",
      "icon": "$(zoom-out)"
    },
    {
      "command": "lumiere.pdf.zoomIn",
      "title": "Zoom In",
      "category": "PDF",
      "icon": "$(zoom-in)"
    },
    {
      "command": "lumiere.pdf.selectZoom",
      "title": "Zoom\u2026",
      "category": "PDF",
      "icon": "$(search-fuzzy)"
    },
    {
      "command": "lumiere.pdf.fitWidth",
      "title": "Fit Width",
      "category": "PDF",
      "icon": "$(arrow-both)"
    },
    {
      "command": "lumiere.pdf.fitPage",
      "title": "Fit Page",
      "category": "PDF",
      "icon": "$(screen-full)"
    },
    {
      "command": "lumiere.pdf.find",
      "title": "Find in PDF",
      "category": "PDF",
      "icon": "$(search)"
    },
    {
      "command": "lumiere.pdf.toggleOutline",
      "title": "Toggle Outline",
      "category": "PDF",
      "icon": "$(list-tree)"
    },
    {
      "command": "lumiere.pdf.selectTextTool",
      "title": "Select Text Tool",
      "category": "PDF",
      "icon": "$(whole-word)"
    },
    {
      "command": "lumiere.pdf.selectRegionTool",
      "title": "Select Region Tool",
      "category": "PDF",
      "icon": "$(inspect)"
    },
    {
      "command": "lumiere.pdf.selectAnnotateTool",
      "title": "Annotate",
      "category": "PDF",
      "icon": "$(edit)"
    },
    {
      "command": "lumiere.pdf.toggleAnnotateTool",
      "title": "Toggle Annotate",
      "category": "PDF",
      "icon": "$(edit)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.pickAnnotationTool",
      "title": "Annotation Tool\u2026",
      "category": "PDF",
      "icon": "$(paintcan)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.pickAnnotationColor",
      "title": "Annotation Color\u2026",
      "category": "PDF",
      "icon": "$(symbol-color)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.annotationUndo",
      "title": "Undo Annotation",
      "category": "PDF",
      "icon": "$(discard)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.annotationRedo",
      "title": "Redo Annotation",
      "category": "PDF",
      "icon": "$(redo)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.annotationRetrySave",
      "title": "Retry Annotation Save",
      "category": "PDF",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.deleteAnnotation",
      "title": "Delete Annotation",
      "category": "PDF",
      "enablement": "lumiere.pdf.pdfActive && lumiere.pdf.tool == 'annotate' && lumiere.pdf.hasSelection"
    },
    {
      "command": "lumiere.pdf.selectToolbarMode",
      "title": "Choose Toolbar Location\u2026",
      "category": "PDF",
      "icon": "$(layout)"
    },
    {
      "command": "lumiere.pdf.cyclePageColors",
      "title": "Cycle Page Colors",
      "category": "PDF",
      "icon": "$(color-mode)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.actualSize",
      "title": "Actual Size (100%)",
      "category": "PDF",
      "icon": "$(symbol-numeric)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.selectView",
      "title": "View\u2026",
      "category": "PDF",
      "icon": "$(layout)",
      "enablement": "lumiere.pdf.pdfActive"
    },
    {
      "command": "lumiere.pdf.singlePage",
      "title": "Single Page",
      "category": "PDF",
      "icon": "$(file)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.pageLayout == 'single'"
    },
    {
      "command": "lumiere.pdf.twoPageSpread",
      "title": "Two Pages (1\u20132, 3\u20134)",
      "category": "PDF",
      "icon": "$(book)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.pageLayout == 'spread'"
    },
    {
      "command": "lumiere.pdf.twoPageCover",
      "title": "Two Pages with Cover (1, 2\u20133)",
      "category": "PDF",
      "icon": "$(book)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.pageLayout == 'spreadCover'"
    },
    {
      "command": "lumiere.pdf.continuousScroll",
      "title": "Continuous Scrolling",
      "category": "PDF",
      "icon": "$(list-ordered)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.scrollMode == 'continuous'"
    },
    {
      "command": "lumiere.pdf.pageByPage",
      "title": "Page-by-page Scrolling",
      "category": "PDF",
      "icon": "$(file)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.scrollMode == 'paged'"
    },
    {
      "command": "lumiere.pdf.verticalScroll",
      "title": "Vertical Scrolling",
      "category": "PDF",
      "icon": "$(arrow-down)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.scrollDirection == 'vertical'"
    },
    {
      "command": "lumiere.pdf.horizontalScroll",
      "title": "Horizontal Scrolling",
      "category": "PDF",
      "icon": "$(arrow-right)",
      "enablement": "lumiere.pdf.pdfActive",
      "toggled": "lumiere.pdf.scrollDirection == 'horizontal'"
    },
    {
      "command": "lumiere.pdf.historyBack",
      "title": "Back to Previous Location",
      "category": "PDF",
      "icon": "$(arrow-left)",
      "enablement": "lumiere.pdf.historyBack"
    },
    {
      "command": "lumiere.pdf.historyForward",
      "title": "Forward to Next Location",
      "category": "PDF",
      "icon": "$(arrow-right)",
      "enablement": "lumiere.pdf.historyForward"
    },
    {
      "command": "lumiere.pdf.ideContext.copy",
      "title": "Copy IDE Context",
      "category": "Lumi\u00e8re PDF"
    },
    {
      "command": "lumiere.pdf.ideContext.send",
      "title": "Send IDE Context to Agent\u2026",
      "category": "Lumi\u00e8re PDF"
    }
  ],
  "menus": {
    "view/title": [
      {
        "command": "lumiere.pdf.expandOutline",
        "when": "view == lumiere.pdf.outline",
        "group": "navigation@1"
      },
      {
        "command": "lumiere.pdf.enableOutlineFollowCursor",
        "when": "view == lumiere.pdf.outline && !lumiere.pdf.outlineFollowCursor",
        "group": "1_outline@1"
      },
      {
        "command": "lumiere.pdf.disableOutlineFollowCursor",
        "when": "view == lumiere.pdf.outline && lumiere.pdf.outlineFollowCursor",
        "group": "1_outline@1"
      }
    ],
    "editor/title": [
      {
        "command": "lumiere.pdf.find",
        "when": "activeCustomEditorId == 'lumiere.pdf.viewer'",
        "group": "0_pdfFind@1"
      },
      {
        "command": "lumiere.pdf.previousPage",
        "when": "activeCustomEditorId == 'lumiere.pdf.viewer'",
