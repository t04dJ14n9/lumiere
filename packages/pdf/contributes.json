    "webview/context": [
      {
        "command": "lumiere.pdf.lookUp",
        "when": "webviewId == 'lumiere.pdf.viewer' && isMac && config.lumiere.pdf.lookUp.enabled",
        "group": "0_agent@2"
      },
      {
        "command": "lumiere.pdf.copyLinkForAgent",
        "when": "webviewId == 'lumiere.pdf.viewer' && lumiere.pdf.hasSelection",
        "group": "0_agent@1"
      },
      {
        "command": "lumiere.pdf.deleteAnnotation",
        "when": "webviewId == 'lumiere.pdf.viewer' && lumiere.pdf.tool == 'annotate' && lumiere.pdf.hasSelection",
        "group": "0_agent@3"
      },
      {
        "command": "lumiere.pdf.goToPage",
        "when": "webviewId == 'lumiere.pdf.viewer'",
        "group": "1_pdfView@1"
      },
