{
  "name": "@workshop/pdf",
  "version": "0.0.0",
  "private": true,
  "description": "Lumière PDF: an EmbedPDF-based viewer that copies selections with exact page-and-box locations.",
  "exports": {
    "./host": "./src/extension/extension.ts",
    "./contributes.json": "./contributes.json",
    "./lazy-bridge-server": "./scripts/lazy-bridge-server.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/extension && tsc -p src/bridge-stdio && tsc -p src/webview && tsc -p test",
    "test": "tsx --test test/unit/*.test.ts test/unit/*/*.test.ts",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "test:browser": "node scripts/build.mjs && pnpm fixtures && playwright test --config test/browser/playwright.config.ts"
  },
  "dependencies": {
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-bookmark": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-search": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-spread": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vscode/codicons": "0.0.45",
    "@workshop/agents": "workspace:*",
    "@workshop/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0"
  }
}
