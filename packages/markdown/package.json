{
  "name": "@workshop/markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Lumière: Obsidian-style Live Preview for VS Code and Cursor.",
  "exports": {
    "./host": "./src/host/extension.ts",
    "./portable": "./src/host/portable.ts",
    "./node": "./src/host/node.ts",
    "./contributions": "./scripts/contributions.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/host && tsc -p src/webview && tsc -p src/plugins/tsconfig.host.json && tsc -p src/plugins/tsconfig.webview.json && tsc -p src/workers && tsc -p src/workers/tsconfig.web.json && tsc -p test",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/build.mjs && playwright test -c test/browser/playwright.config.ts",
    "test:quality": "node scripts/build.mjs && playwright test -c test/quality/playwright.config.ts && tsx --test test/quality/large-vault.test.ts",
    "sample": "node scripts/build-sample.mjs",
    "ledger": "node scripts/test-ledger.mjs",
    "measure:vault": "node scripts/build.mjs && tsx scripts/measure-vault.ts",
    "measure:scroll": "node scripts/build.mjs && playwright test -c test/perf/playwright.config.ts",
    "scroll-vault": "tsx scripts/scroll-vault.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/collab": "6.1.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@embedpdf/pdfium": "2.15.1",
    "@lezer/common": "1.5.3",
    "@lezer/cpp": "1.1.6",
    "@lezer/css": "1.3.9",
    "@lezer/go": "1.0.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/html": "1.3.13",
    "@lezer/java": "1.1.5",
    "@lezer/javascript": "1.5.6",
    "@lezer/json": "1.0.3",
    "@lezer/markdown": "1.8.0",
    "@lezer/php": "1.0.6",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.3",
    "@lezer/sass": "1.1.0",
    "@lezer/xml": "1.0.6",
    "@lezer/yaml": "1.0.4",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@replit/codemirror-vim": "6.4.0",
    "@workshop/agents": "workspace:*",
    "@workshop/core": "workspace:*",
    "@workshop/ink": "workspace:*",
    "dompurify": "3.4.17",
    "graphology": "0.26.0",
    "lucide": "1.57.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "mermaid": "12.2.0",
    "prismjs": "1.30.0",
    "sigma": "3.0.2",
    "turndown": "^7.2.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it-footnote": "3.0.4",
    "@types/prismjs": "1.26.6",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "1.125.0"
  }
}
