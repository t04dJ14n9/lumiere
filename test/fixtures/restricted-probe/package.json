{
  "name": "test-restricted-probe",
  "displayName": "Test restricted-workspace probe",
  "description": "Reports effective settings and intercepted agent calls for isolated Restricted Mode tests.",
  "publisher": "vscode-pdf-workshop-tests",
  "version": "0.0.1",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "contributes": {
    "commands": [{ "command": "pdfWorkshopTests.reportTrust", "title": "PDF Test: Report Workspace Trust" }]
  }
}
