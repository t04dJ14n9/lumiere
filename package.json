{
  "name": "vscode-embedpdf",
  "displayName": "Agent PDF Viewer (EmbedPDF)",
  "description": "A PDF viewer built on EmbedPDF. Select text or a region and copy an exact page-and-box reference for your coding agent.",
  "version": "0.1.0",
  "publisher": "t04dj14n9",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/t04dJ14n9/vscode-embedPDF.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "embedpdf",
    "agent",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscodeEmbedPdf.viewer",
        "displayName": "Agent PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vscodeEmbedPdf.outline",
          "name": "PDF Outline",
          "when": "vscodeEmbedPdf.pdfActive"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vscodeEmbedPdf.outline",
        "contents": "Reading the outline\u2026",
        "when": "vscodeEmbedPdf.outlineLoading"
      },
      {
        "view": "vscodeEmbedPdf.outline",
        "contents": "This PDF has no outline.",
        "when": "!vscodeEmbedPdf.outlineLoading"
      }
    ],
    "commands": [
      {
        "command": "vscodeEmbedPdf.copyForAgent",
        "title": "Copy for Agent",
        "category": "PDF",
        "icon": "$(copy)",
        "enablement": "vscodeEmbedPdf.hasSelection"
      },
      {
        "command": "vscodeEmbedPdf.openLocation",
        "title": "Open Location\u2026",
        "category": "PDF"
      },
      {
        "command": "vscodeEmbedPdf.goToOutlineItem",
        "title": "Go to Outline Item",
        "category": "PDF"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscodeEmbedPdf.copyForAgent",
          "when": "activeCustomEditorId == 'vscodeEmbedPdf.viewer' && vscodeEmbedPdf.hasSelection",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vscodeEmbedPdf.copyForAgent",
          "when": "activeCustomEditorId == 'vscodeEmbedPdf.viewer'"
        },
        {
          "command": "vscodeEmbedPdf.goToOutlineItem",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/extension && tsc -p src/webview && tsc -p test",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test test/unit/*.test.ts",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "test:browser": "pnpm build && pnpm fixtures && playwright test --config test/browser/playwright.config.ts",
    "test:vscode": "pnpm build && pnpm fixtures && playwright test --config test/vscode/playwright.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "package": "node scripts/build.mjs --production && node scripts/third-party-notices.mjs && vsce package --no-dependencies"
  },
  "dependencies": {
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-bookmark": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-search": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  },
  "packageManager": "pnpm@10.28.2"
}
