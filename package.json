          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.tables"
        },
        {
          "command": "markdownWorkbench.toggleChecklist",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.tasks"
        },
        {
          "command": "markdownWorkbench.cycleListChecklist",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.tasks"
        },
        {
          "command": "markdownWorkbench.consumeVimHostShortcut",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "markdownWorkbench.copyForAgent",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.copyForAgent && webviewSection == 'markdownContent' && markdownWorkbench.hasSelection",
          "group": "agent"
        },
        {
          "command": "markdownWorkbench.selectionActions",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.editor && webviewSection == 'markdownContent' && markdownWorkbench.hasSelection && markdownWorkbench.hasSelectionActions",
          "group": "agent"
        },
        {
          "command": "markdownWorkbench.toggleBold",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.formatting && webviewSection == 'markdownContent'",
          "group": "formatting"
        },
        {
          "command": "markdownWorkbench.toggleItalics",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.formatting && webviewSection == 'markdownContent'",
          "group": "formatting"
        },
        {
          "command": "markdownWorkbench.toggleStrikethrough",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.formatting && webviewSection == 'markdownContent'",
          "group": "formatting"
        },
        {
          "command": "markdownWorkbench.toggleHighlight",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.formatting && webviewSection == 'markdownContent'",
          "group": "formatting"
        },
        {
          "command": "markdownWorkbench.toggleCode",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.formatting && webviewSection == 'markdownContent'",
          "group": "formatting"
        },
        {
          "command": "markdownWorkbench.insertLink",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.formatting && webviewSection == 'markdownContent'",
          "group": "formatting"
        }
      ],
      "editor/title": [
        {
          "command": "markdownWorkbench.copyForAgent",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.copyForAgent && markdownWorkbench.hasSelection",
          "group": "navigation"
        },
        {
          "command": "markdownWorkbench.titleActions",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.editor && markdownWorkbench.hasTitleActions",
          "group": "navigation"
        },
        {
          "command": "markdownWorkbench.addProperty",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.properties",
          "group": "navigation"
        },
        {
          "command": "markdownWorkbench.openAsText",
          "when": "activeCustomEditorId == 'markdownWorkbench.editor' && markdownWorkbench.plugin.commands",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Workbench",
      "properties": {
        "markdownWorkbench.plugins.autoPair.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Auto pair in the Markdown editor."
        },
        "markdownWorkbench.plugins.backlinks.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Backlinks view and status bar count for the active note, with unlinked mentions."
        },
        "markdownWorkbench.plugins.callouts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render callouts and remember their disclosure state per panel."
        },
        "markdownWorkbench.plugins.codeBlocks.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Highlight rendered and editable code fences; copy code."
        },
        "markdownWorkbench.plugins.copyForAgent.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Copy a saved source line reference or selected text for an agent."
        },
        "markdownWorkbench.plugins.diagrams.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render Mermaid diagrams in strict mode."
        },
        "markdownWorkbench.plugins.embeds.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Transclude notes, images and media; open attachment cards."
        },
        "markdownWorkbench.plugins.folding.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Folding in the Markdown editor."
        },
        "markdownWorkbench.plugins.footnotes.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Footnote references, definitions, previews and navigation."
        },
        "markdownWorkbench.plugins.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Markdown editing commands."
        },
        "markdownWorkbench.plugins.indentGuides.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Indentation guides in the Markdown editor."
        },
        "markdownWorkbench.plugins.inlineTitle.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show and rename the note title above its Markdown content."
        },
        "markdownWorkbench.plugins.lineNumbers.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Line numbers in the Markdown editor."
        },
        "markdownWorkbench.plugins.linkUpdates.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Update links in other notes when a note or attachment is renamed or moved in VS Code."
        },
        "markdownWorkbench.plugins.links.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Follow Markdown links and wikilinks."
        },
        "markdownWorkbench.plugins.math.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render TeX formulas with MathJax."
        },
        "markdownWorkbench.plugins.outgoingLinks.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Outgoing links view: the notes and files the active note links to, and links not created yet."
        },
        "markdownWorkbench.plugins.outline.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Outline view of the active note's headings, following the caret. VS Code's own Outline covers the text editor."
        },
        "markdownWorkbench.plugins.pagePreview.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Preview internal links with a modifier hover or keyboard."
        },
        "markdownWorkbench.plugins.pasteHtml.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Convert rich clipboard HTML into Markdown in notes and table cells."
        },
        "markdownWorkbench.plugins.properties.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Edit YAML properties as typed fields, lists and ordered rows."
        },
        "markdownWorkbench.plugins.quickSwitcher.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Find a note by name, alias or path, or create it, like Obsidian's quick switcher."
        },
        "markdownWorkbench.plugins.search.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render query blocks as live vault search results."
        },
        "markdownWorkbench.plugins.smartLists.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Smart lists in the Markdown editor."
        },
        "markdownWorkbench.plugins.spellcheck.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Spellcheck in the Markdown editor."
        },
        "markdownWorkbench.plugins.suggest.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Complete links, headings, blocks and tags from the vault index."
        },
        "markdownWorkbench.plugins.tables.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Edit Markdown tables as grids with projected cell editing."
        },
        "markdownWorkbench.plugins.tags.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Render tags, find notes with matching hierarchical tags, and list the vault's tags in the Tags view."
        },
        "markdownWorkbench.plugins.tasks.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Interactive checkboxes and checklist commands."
        },
        "markdownWorkbench.plugins.vim.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Vim in the Markdown editor."
        },
        "markdownWorkbench.plugins.wordCount.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Word and character count of the active note, or of the selection, in the status bar."
        },
        "markdownWorkbench.autoPair.brackets": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.autoPair.markdown": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.editor.defaultMode": {
          "enum": [
            "livePreview",
            "source"
          ],
          "default": "livePreview",
          "scope": "resource"
        },
        "markdownWorkbench.editor.readableLineLength": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.editor.strictLineBreaks": {
          "type": "boolean",
          "default": false,
          "scope": "resource"
        },
        "markdownWorkbench.editor.rightToLeft": {
          "type": "boolean",
          "default": false,
          "scope": "resource"
        },
        "markdownWorkbench.editor.useTabs": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.editor.tabSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 4,
          "scope": "resource"
        },
        "markdownWorkbench.folding.heading": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.folding.indent": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.linkUpdates.mode": {
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "default": "prompt",
          "description": "Obsidian's Automatically update internal links: `prompt` asks before rewriting links in other notes when a file is renamed or moved.",
          "scope": "resource"
        },
        "markdownWorkbench.links.newLinkFormat": {
          "enum": [
            "shortest",
            "relative",
            "absolute"
          ],
          "default": "shortest",
          "scope": "resource"
        },
        "markdownWorkbench.links.useWikilinks": {
          "type": "boolean",
          "default": true,
          "scope": "resource"
        },
        "markdownWorkbench.links.folderNote": {
          "type": "string",
          "default": "",
          "scope": "resource"
        },
        "markdownWorkbench.files.newNoteFolder": {
          "type": "string",
          "default": "",
          "description": "New notes: empty for vault root, . for current folder, or a vault-relative path.",
          "scope": "resource"
        },
        "markdownWorkbench.files.attachmentFolder": {
          "type": "string",
          "default": "",
          "description": "Attachment destination policy: empty for vault root, . for current folder, or ./sub. Rich HTML paste keeps links and does not import files.",
          "scope": "resource"
        },
        "markdownWorkbench.properties.display": {
          "enum": [
            "visible",
            "hidden",
            "source"
          ],
          "default": "visible",
          "scope": "resource"
        },
        "markdownWorkbench.tags.viewSort": {
          "enum": [
            "name",
            "frequency"
          ],
          "default": "name",
          "description": "Order of the Tags view: `name` (A to Z) or `frequency` (most notes first).",
          "scope": "resource"
        },
        "markdownWorkbench.tags.viewNested": {
          "type": "boolean",
          "default": true,
          "description": "Show nested tags (`#a/b`) under their parent in the Tags view, rather than as a flat list.",
          "scope": "resource"
        },
        "markdownWorkbench.vault.rootMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".obsidian"
          ],
          "description": "A folder containing one of these entries is a vault root; without one, the workspace folder is the vault.",
          "scope": "resource"
        },
        "markdownWorkbench.vault.excludedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
