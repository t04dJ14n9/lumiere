{
  "name": "vscode-markdown-workbench",
  "displayName": "Markdown Workbench",
  "description": "Plugin-based Markdown Live Preview for VS Code.",
  "version": "0.1.0",
  "publisher": "t04dj14n9",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "types": "./dist/api/types.d.ts",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {},
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Remote content and external code processors are disabled."
    }
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/host && tsc -p src/webview && tsc -p src/plugins/tsconfig.host.json && tsc -p src/plugins/tsconfig.webview.json && tsc -p src/workers && tsc -p test",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/test.mjs",
    "test:browser": "pnpm build && playwright test -c test/browser/playwright.config.ts",
    "test:vscode": "playwright test -c test/vscode/playwright.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm contributions --check",
    "contributions": "tsx scripts/generate-contributions.ts",
    "package": "pnpm build && vsce package --no-dependencies",
    "ledger": "node scripts/test-ledger.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/collab": "6.1.1",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.6.3",
    "@mathjax/src": "4.1.2",
    "@replit/codemirror-vim": "6.3.0",
    "dompurify": "3.4.7",
    "lucide": "0.468.0",
    "markdown-it": "14.3.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "mermaid": "11.4.1",
    "prismjs": "1.29.0",
    "turndown": "^7.2.4",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.60.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.35.0",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/prismjs": "1.26.5",
    "@types/turndown": "^5.0.6",
    "prettier": "3.6.2"
  }
}
