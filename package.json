    "@lezer/markdown": "1.6.3",
    "@mathjax/src": "4.1.2",
    "@replit/codemirror-vim": "6.3.0",
    "dompurify": "3.4.7",
    "lucide": "0.468.0",
    "markdown-it": "14.3.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "mermaid": "11.4.1",
    "prismjs": "1.29.0",
