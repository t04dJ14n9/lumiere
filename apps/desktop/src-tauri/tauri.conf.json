{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumière",
  "version": "0.1.5",
  "identifier": "io.github.t04dj14n9.lumiere",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown notes, Obsidian-compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown note",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
