{
  "name": "@workshop/ipad",
  "version": "0.0.0",
  "private": true,
  "description": "Lumière on the iPad: a Capacitor app around Lumière's window and host-web, with native plugins that provide host services.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "node scripts/build.mjs && cap sync ios",
    "typecheck": "tsc -p src"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@workshop/app": "workspace:*",
    "@workshop/core": "workspace:*",
    "@workshop/host-node": "workspace:*",
    "@workshop/host-web": "workspace:*",
    "@workshop/ink": "workspace:*",
    "@workshop/markdown": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
